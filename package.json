{
  "name": "library-api",
  "version": "1.0.0",
  "description": "Backend API for the library-portal frontend (MVP: login + book catalog).",
  "type": "module",
  "private": true,
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "DATABASE_URL=\"postgresql://library:library@localhost:5432/library_test\" JWT_SECRET=\"test-secret\" vitest --run tests/",
    "test:integration": "DATABASE_URL=\"postgresql://library:library@localhost:5432/library_test\" JWT_SECRET=\"test-secret\" vitest --run tests/",
    "test:unit": "JWT_SECRET=\"test-secret\" vitest --run src/",
    "db:migrate": "docker compose run --rm liquibase update",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.14.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
