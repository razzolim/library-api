generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Table and column names are mapped to snake_case (via @@map/@map) to match
// SQL convention, while Prisma model/field names stay camelCase to match
// idiomatic JS and the JSON API contract. Application code always uses the
// camelCase field names below — the @map targets are a storage-only detail.
model User {
  id                 Int               @id @default(autoincrement())
  username           String            @unique
  password           String
  fullName           String            @map("full_name")
  role               String            @default("reader")
  isActive           Boolean           @default(true) @map("is_active")
  // Optional. Uniqueness is case-insensitive via a LOWER(email) unique index that
  // exists only in liquibase/changesets (Prisma cannot model functional indexes).
  email              String?           @db.VarChar(255)
  locale             String            @default("en")
  // Tokens issued at or before this instant are rejected (admin password reset
  // signs the target out everywhere). Null = no cutoff. See ADR "Admin Area".
  sessionsValidAfter DateTime?         @map("sessions_valid_after")
  // Set on every successful login. Null = never logged in.
  lastLoginAt        DateTime?         @map("last_login_at")
  // Only what the user has changed; defaults are filled in by users.service. See reader spec §4.
  readerPreferences  Json?             @map("reader_preferences")
  readingProgress    ReadingProgress[]
  bookmarks          Bookmark[]

  @@map("user")
}

model Book {
  id              Int               @id @default(autoincrement())
  title           String
  author          String
  year            Int?
  genre           String?
  status          String            @default("available")
  isbn            String?
  // Hyphen-free copy of isbn, used only for the uniqueness check.
  isbnNormalized  String?           @unique @map("isbn_normalized")
  coverColor      String            @default("#4a5568") @map("cover_color")
  // Longer blurb, only returned by GET /books/:id — omitted from GET /books
  // to keep the list payload light. See backend-api-specification.md 3.1/3.2.
  summary         String?
  // Embeddable PDF URL, only returned by GET /books/:id — same "heavy detail
  // field" treatment as summary. Nullable: not every book has an online copy.
  pdfUrl          String?           @map("pdf_url")
  // Page count of the PDF; optional (the CSV import may leave it empty).
  pageCount       Int?              @map("page_count")
  uploadedBy      String            @map("uploaded_by")
  uploadedAt      DateTime          @default(now()) @map("uploaded_at")
  readingProgress ReadingProgress[]
  bookmarks       Bookmark[]

  @@map("book")
}

model ChangelogEntry {
  id          Int    @id @default(autoincrement())
  version     String @unique
  date        String
  title       String
  description String

  @@map("changelog_entry")
}

// Denylist of logged-out tokens, keyed by their `jti` claim. See ADR-0002.
model RevokedToken {
  id        Int      @id @default(autoincrement())
  jti       String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("revoked_token")
}

// Record of admin actions. No FK to user on purpose: the trail must outlive
// the rows it refers to. `metadata` must never hold passwords or tokens.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId Int      @map("actor_user_id")
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  ip          String?
  userAgent   String?  @map("user_agent")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}

// Per-user reading position. Deleting the user or the book deletes the row.
model ReadingProgress {
  userId        Int      @map("user_id")
  bookId        Int      @map("book_id")
  page          Int
  totalPages    Int      @map("total_pages")
  percent       Decimal  @db.Decimal(5, 2)
  updatedAt     DateTime @map("updated_at") @db.Timestamptz(3)
  firstOpenedAt DateTime @default(now()) @map("first_opened_at") @db.Timestamptz(3)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book          Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([userId, bookId])
  @@index([userId, updatedAt(sort: Desc)], map: "reading_progress_user_updated_idx")
  @@map("reading_progress")
}

model Bookmark {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  bookId    Int      @map("book_id")
  page      Int
  note      String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId, page])
  @@map("bookmark")
}

// Admin-managed on/off switches. `key` is immutable. `updatedBy` is a plain username (no FK)
// so the flag survives deletion of the admin who last changed it.
model FeatureFlag {
  key         String   @id @db.VarChar(64)
  description String   @default("") @db.VarChar(255)
  enabled     Boolean  @default(false)
  updatedAt   DateTime @default(now()) @map("updated_at")
  updatedBy   String?  @map("updated_by")

  @@map("feature_flag")
}
