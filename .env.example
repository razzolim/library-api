PORT=3000

# Postgres connection. Run `docker compose up -d db` to start the database, then point
# DATABASE_URL at its published localhost port. POSTGRES_USER/PASSWORD/DB also configure the
# `db` service itself in docker-compose.yml — these are non-secret local-dev defaults, not
# production credentials.
DATABASE_URL="postgresql://library:library@localhost:5432/library"
POSTGRES_USER="library"
POSTGRES_PASSWORD="library"
POSTGRES_DB="library"

JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1h"
CORS_ORIGIN="http://localhost:5173"

# Seeded by prisma/seed.js. These are intentionally the well-known demo
# credentials documented in documents/backend-api-specification.md (Section
# 6.1) — override them if you want a different demo account, but do not put
# real user credentials here.
DEMO_USER_USERNAME="reader"
DEMO_USER_PASSWORD="reader"
DEMO_USER_FULL_NAME="Demo Reader"
DEMO_USER_ROLE="reader"
